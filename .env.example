# Copier ce fichier en ".env" et adapter les valeurs si besoin.
# docker-compose lit automatiquement le fichier ".env" a la racine.

# --- MySQL ---
DB_NAME=school_management
DB_USERNAME=school_user
DB_PASSWORD=school_password
DB_ROOT_PASSWORD=root
DB_PORT=3306

# --- Backend ---
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=5173

# --- phpMyAdmin ---
PHPMYADMIN_PORT=8081
